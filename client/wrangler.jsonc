{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geekly-client",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "routes": [
    {
      "pattern": "geekly.in",
      "custom_domain": true,
      "zone_name": "geekly.in"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}