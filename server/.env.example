# Server
PORT=3000
NODE_ENV=development

# Browser origins allowed to call the API, comma separated.
# Leave empty to allow any origin (local development only).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# MongoDB - the part after the last slash is the database name
MONGODB_URI=mongodb://localhost:27017/main_db

# Single admin account (no Admin model/table) - POST /api/admin/auth/login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# JWT - use a long random secret in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional separate secret for refresh tokens (defaults to JWT_SECRET)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Frontend origin - OAuth callbacks redirect here with ?token=...
FRONTEND_URL=http://localhost:3001

# Admin console origin (separate app)
ADMIN_URL=http://localhost:3002

# OAuth callback URLs - full URLs, must EXACTLY match the provider consoles:
#   Google:  http://localhost:3000/api/auth/google/callback
#            https://api.geekly.in/api/auth/google/callback
#   GitHub:  http://localhost:3000/api/auth/github/callback
#            https://api.geekly.in/api/auth/github/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Register GOOGLE_CALLBACK_URL as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - https://github.com/settings/developers
# Register GITHUB_CALLBACK_URL as the Authorization callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# AI — OpenAI SDK pointed at the OpenRouter-compatible endpoint.
# Text and image models are managed in the admin console (Settings → AI models).
OPENROUTER_API_KEY=



REDIS_URL=""

# Cloudflare R2 for article images and topic banners. Placeholders only.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_PUBLIC_URL="https://assets.geekly.in"
CLOUDFLARE_R2_ASSETS_BUCKET="geekly"

AWS_REGION="ap-south-1"
